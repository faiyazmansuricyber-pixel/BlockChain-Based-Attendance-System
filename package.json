{
  "name": "blockchain-attendance-system",
  "version": "1.0.0",
  "description": "Decentralized, tamper-proof academic attendance tracking system built on Ethereum (Solidity, Hardhat, Ethers.js) and React (Vite, Tailwind CSS).",
  "author": "Mansuri Faiyaz",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "node": "npx hardhat node",
    "deploy": "npx hardhat run scripts/deploy.js --network localhost",
    "seed": "npx hardhat run scripts/seed.js --network localhost",
    "register": "npx hardhat run scripts/register-class.js --network localhost",
    "reset": "node scripts/reset.cjs",
    "demo": "node scripts/demo.cjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.2",
    "ethers": "^6.11.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.359.0",
    "qrcode.react": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "hardhat": "^2.22.2",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.2.0"
  }
}
